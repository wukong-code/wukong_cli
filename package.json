{
  "name": "@wukong/monorepo",
  "version": "0.1.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-perms.mjs",
    "build": "pnpm -r run build",
    "build:packages": "pnpm -r --filter './packages/*' run build",
    "dev:cli": "pnpm -C apps/wukong run dev",
    "dev:server": "pnpm -C apps/wukong run dev:server",
    "build:plugin-marketplace": "pnpm -C apps/wukong run build:plugin-marketplace",
    "typecheck": "pnpm run build:packages && pnpm -r --filter './packages/*' run typecheck && pnpm --filter @wukong.today/code run typecheck",
    "lint": "oxlint --type-aware && pnpm run lint:boundaries",
    "lint:boundaries": "pnpm run test:boundaries && node scripts/check-agent-core-boundaries.mjs",
    "lint:fix": "oxlint --type-aware --fix && pnpm run lint:boundaries",
    "lint:pkg": "pnpm --filter @wukong.today/code exec publint && pnpm --filter @wukong.today/code exec attw --pack . --profile node16 --ignore-rules cjs-resolves-to-esm",
    "sherif": "sherif",
    "test": "vitest run",
    "test:boundaries": "node --test scripts/check-agent-core-boundaries.test.mjs",
    "test:watch": "vitest",
    "test:related": "vitest related --run --passWithNoTests",
    "test:changed": "vitest run --changed --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:coverage:gate": "WUKONG_COVERAGE_GATE=1 vitest run --coverage",
    "test:coverage:cli": "vitest run --coverage --project cli",
    "test:coverage:cli:gate": "WUKONG_COVERAGE_GATE=1 vitest run --coverage --project cli",
    "clean": "pnpm -r run clean",
    "changeset": "changeset",
    "version": "changeset version",
    "version:release": "changeset version",
    "publish": "pnpm run typecheck && pnpm run lint && pnpm run sherif && pnpm run test && pnpm run build && pnpm run lint:pkg && changeset publish",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.4",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.30.0",
    "@microsoft/api-extractor": "7.58.12",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "4.1.4",
    "@wukong/build-support": "workspace:*",
    "lint-staged": "16.4.0",
    "oxlint": "1.59.0",
    "oxlint-tsgolint": "0.20.0",
    "pkg-pr-new": "0.0.75",
    "publint": "0.3.18",
    "sherif": "1.11.1",
    "simple-git-hooks": "2.13.1",
    "tsdown": "0.22.0",
    "tsx": "^4.21.0",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  },
  "simple-git-hooks": {},
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix --quiet",
      "oxlint --type-aware --quiet"
    ]
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@10.33.0"
}
