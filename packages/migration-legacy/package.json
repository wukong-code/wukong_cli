{
  "name": "@wukong/migration-legacy",
  "version": "0.1.15",
  "description": "Migrate wukong-cli (~/.wukong/) data into wukong (~/.wukong/).",
  "license": "MIT",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "imports": {
    "#/*": [
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@wukong/agent-core": "workspace:^",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@wukong/kaos": "workspace:^"
  }
}
